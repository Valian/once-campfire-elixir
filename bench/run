#!/usr/bin/env python3
"""Benchmark Campfire implementations side by side in Docker on macOS (Docker Desktop).

  bench/run [--apps reference,elixir-official,ours] [--reps 3] [--out DIR] [--user-agent UA]
  bench/report DIR        # markdown summary (bench/run writes DIR/report.md itself)

A macOS port of once-campfire-rust's bench/run. Each rep, for each app in turn (never two at once;
the order alternates between reps): a fresh copy of bench/seed mounted at /rails/storage/db and
/rails/storage/files, a fresh container limited to CPUS, wait for /up (cold start), idle memory,
then the HTTP suite, the Action Cable fan-out suite and the upload suite, all driven by
bench/loadgen running on the host against the published port.

Images:  REFERENCE_IMAGE=campfire-reference:app        (bench/make-seed builds it)
         ELIXIR_OFFICIAL_IMAGE=campfire-elixir:release   (basecamp/once-campfire-elixir)
         OURS_IMAGE=campfire-phoenix:app                 (this repo's Dockerfile)
Knobs (env): CPUS=4 (docker --cpus) or CPUSET=0-3 (docker --cpuset-cpus, also makes nproc=4)
  HTTP_SECS=8 HTTP_CONCS="1 16 64" CABLE_CLIENTS="100 500 1000" CABLE_TPUT_SECS=15 CABLE_POSTERS=4
  UPLOAD_REPS=5 PORT=4390 SUITES="http cable upload" SETTLE_SECS=10 LOAD_MAX=8 LOAD_WAIT_SECS=60
  EXTRA_ENV="K=V K2=V2" (added to every container)
"""
import argparse, json, math, os, resource, shutil, subprocess, sys, time, urllib.request
from datetime import datetime

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
from common import (BENCH, SEED, LOADGEN, E, HTTP_SECS, HTTP_CONCS, CABLE_CLIENTS, PORT, SUITES, SETTLE_SECS,
                    EXTRA_ENV, BASE, log, cpuset_size, app_env, neuter_deliveries, run_suites, load_labels, write_report)

IMAGES = {
    "reference": E("REFERENCE_IMAGE", "campfire-reference:app"),
    "elixir-official": E("ELIXIR_OFFICIAL_IMAGE", "campfire-elixir:release"),
    "ours": E("OURS_IMAGE", "campfire-phoenix:app"),
}
CPUSET = E("CPUSET", "")
CPUS = E("CPUS", "4")
NCPU = cpuset_size(CPUSET) if CPUSET else math.ceil(float(CPUS))
LOAD_MAX = float(E("LOAD_MAX", "8"))
LOAD_WAIT_SECS = int(E("LOAD_WAIT_SECS", "60"))
CONTAINER = f"bench-campfire-{PORT}"
UA = []


def sh(*cmd, check=True):
    return subprocess.run(cmd, check=check, capture_output=True, text=True).stdout.strip()


def lg(*args, stderr=None):
    out = subprocess.run([LOADGEN, *map(str, args), *UA], check=True, stdout=subprocess.PIPE, stderr=stderr, text=True).stdout
    return json.loads(out)


def env_args():
    return [x for e in app_env(NCPU) for x in ("-e", e)]


def copy_seed(dst):
    shutil.rmtree(dst, ignore_errors=True)
    os.makedirs(dst)
    for sub in ("db", "storage"):
        # cp -c: APFS clone, instant and space-free
        subprocess.run(["cp", "-cR", os.path.join(SEED, sub), os.path.join(dst, sub)], check=True)
    neuter_deliveries(os.path.join(dst, "db", "production.sqlite3"))


def up():
    try:
        return urllib.request.urlopen(BASE + "/up", timeout=2).status == 200
    except Exception:
        return False


def start_app(app, work):
    sh("docker", "rm", "-f", CONTAINER, check=False)
    copy_seed(work)
    limit = ["--cpuset-cpus", CPUSET] if CPUSET else ["--cpus", CPUS]
    t0 = time.time()
    # Bridge network + published port (Docker Desktop has no real host networking). --dns 127.0.0.1
    # keeps the app off the internet, as the original's NETWORK=bridge mode did.
    sh("docker", "run", "-d", "--name", CONTAINER, *limit, "--dns", "127.0.0.1",
       "-p", f"127.0.0.1:{PORT}:80", *env_args(),
       "-v", f"{work}/db:/rails/storage/db", "-v", f"{work}/storage:/rails/storage/files", IMAGES[app])
    while time.time() - t0 < 120:
        if up():
            return round((time.time() - t0) * 1000)
        if sh("docker", "inspect", "-f", "{{.State.Running}}", CONTAINER, check=False) != "true":
            break
        time.sleep(0.02)
    print(sh("docker", "logs", "--tail", "40", CONTAINER, check=False), file=sys.stderr)
    raise SystemExit(f"{app}: /up never answered 200")


def cgroup_mb(name):
    """The container's own cgroup v2 file (memory.current / memory.peak), in MB; None if unreadable."""
    out = subprocess.run(["docker", "exec", CONTAINER, "cat", f"/sys/fs/cgroup/{name}"], capture_output=True, text=True)
    return int(out.stdout) // 1048576 if out.returncode == 0 and out.stdout.strip().isdigit() else None


def wait_for_quiet():
    waited = 0
    while os.getloadavg()[0] >= LOAD_MAX and waited < LOAD_WAIT_SECS:
        time.sleep(10); waited += 10
    log(f"host load before run: {os.getloadavg()[0]:.2f} (waited {waited}s)")


def run_rep(app, rep, out, labels):
    wait_for_quiet()
    load0 = os.getloadavg()
    work = os.path.join(BENCH, ".work", app)
    cold = start_app(app, work)
    time.sleep(SETTLE_SECS)
    idle = cgroup_mb("memory.current")
    log(f"{app} rep {rep}: cold start {cold}ms, idle {idle}MB")

    http, cable, upload = run_suites(app, rep, out, labels, lg,
                                   db_path=os.path.join(work, "db", "production.sqlite3"))

    peak = cgroup_mb("memory.peak")
    f = os.path.join(out, f"{app}-{rep}.json")
    json.dump({"app": app, "rep": rep, "image": IMAGES[app], "cold_start_ms": cold,
               "memory": {"idle_current_mb": idle, "cgroup_peak_mb": peak},
               "http": http, "cable": cable, "upload": upload,
               "loadavg_start": load0, "loadavg_end": os.getloadavg()}, open(f, "w"), indent=1)
    sh("docker", "rm", "-f", CONTAINER, check=False)
    shutil.rmtree(work, ignore_errors=True)
    log(f"{app} rep {rep}: done -> {f}")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--apps", default="reference,ours")
    p.add_argument("--reps", type=int, default=3)
    p.add_argument("--out")
    p.add_argument("--user-agent")
    a = p.parse_args()
    if a.user_agent:
        UA.extend(["--user-agent", a.user_agent])
    apps = a.apps.split(",")
    for app in apps:
        if app not in IMAGES:
            raise SystemExit(f"unknown app {app} (one of {', '.join(IMAGES)})")
        if subprocess.run(["docker", "image", "inspect", IMAGES[app]], capture_output=True).returncode:
            raise SystemExit(f"{app}: image {IMAGES[app]} not found")
    labels = load_labels()
    out = a.out or os.path.join(BENCH, "results", datetime.now().strftime("%Y%m%d-%H%M%S"))
    os.makedirs(out, exist_ok=True)

    # 1000 WebSocket clients need more than macOS's default 256 descriptors.
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    resource.setrlimit(resource.RLIMIT_NOFILE, (min(65536, hard), hard))
    subprocess.run(["cargo", "build", "--release", "-q"], cwd=os.path.join(BENCH, "loadgen"), check=True)

    docker_info = sh("docker", "info", "--format", "{{.NCPU}} cpus, {{.MemTotal}} bytes, {{.Architecture}}")
    with open(os.path.join(out, "env.txt"), "w") as f:
        print(f"date: {datetime.now().isoformat()}", file=f)
        print(f"host: {sh('sysctl', '-n', 'machdep.cpu.brand_string')}, {os.cpu_count()} cores, "
              f"{int(sh('sysctl', '-n', 'hw.memsize')) // 2**30}GB, macOS {sh('sw_vers', '-productVersion')}", file=f)
        print(f"docker vm: {docker_info}", file=f)
        print(f"limit: {'--cpuset-cpus ' + CPUSET if CPUSET else '--cpus ' + CPUS} (process model for {NCPU} cpus)", file=f)
        print(f"suites: {SUITES} http secs {HTTP_SECS} concs {HTTP_CONCS} cable {CABLE_CLIENTS}", file=f)
        print(f"env: {' '.join(x for x in env_args() if 'CONCURRENCY' in x or 'THREADS' in x)} {' '.join(EXTRA_ENV)}", file=f)
        for app in apps:
            print(f"{app} image: {IMAGES[app]} {sh('docker', 'image', 'inspect', '-f', '{{.Id}} {{.Created}} {{.Architecture}}', IMAGES[app])}", file=f)
    sys.stderr.write(open(os.path.join(out, "env.txt")).read())

    try:
        for rep in range(1, a.reps + 1):
            for app in (apps if rep % 2 else apps[::-1]):
                run_rep(app, rep, out, labels)
    finally:
        subprocess.run(["docker", "rm", "-f", CONTAINER], capture_output=True)
    write_report(out)


if __name__ == "__main__":
    main()
