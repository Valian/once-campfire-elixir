LOAD_WAIT_SECS = int(E("LOAD_WAIT_SECS", "300"))
REDIS_URL = E("REDIS_URL", "redis://127.0.0.1:6379/0")
REFERENCE_DIR = os.path.abspath(E("REFERENCE_DIR", os.path.join(BENCH, ".cache", "once-campfire")))
OFFICIAL_DIR = os.path.abspath(E("ELIXIR_OFFICIAL_DIR", os.path.join(BENCH, ".cache", "once-campfire-elixir")))
OURS_REL = os.path.abspath(E("OURS_REL", os.path.join(ROOT, "_build", "prod", "rel", "campfire")))
OFFICIAL_REL = os.path.join(OFFICIAL_DIR, "_build", "prod", "rel", "campfire")
OFFICIAL_BIN = os.path.join(OFFICIAL_DIR, ".native", "bin")   # campfire-vips, campfire-html (bench/setup-native)
