UA = []


def sh(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, capture_output=True, text=True, **kw).stdout.strip()


def lg(*args, stderr=None):
    out = subprocess.run(["taskset", "-c", LOADGEN_CPUS, LOADGEN, *map(str, args), *UA], check=True,
                         stdout=subprocess.PIPE, stderr=stderr, text=True).stdout
    return json.loads(out)


def ruby_bin():
    version = E("RUBY_VERSION") or open(os.path.join(REFERENCE_DIR, ".ruby-version")).read().strip()
    return os.path.join(sh("mise", "where", f"ruby@{version}"), "bin")


def thrust():
    """Thruster from the reference's bundle (the official image copies the same binary out of the Rails image)."""
    found = sorted(glob.glob(os.path.join(REFERENCE_DIR, "vendor", "bundle", "ruby", "*", "gems", "thruster-*-linux", "exe", "*-linux", "thrust")))
    if not found:
        raise SystemExit("thrust not found in the reference's bundle: run bench/setup-native")
    return found[-1]


# --- Redis (external; reached over a socket, no redis-cli or Docker needed) ---------------------

def redis(*cmd):
    host, port = REDIS_URL.split("//")[1].split("/")[0].split(":")
    with socket.create_connection((host, int(port)), timeout=5) as s:
        s.sendall(f"*{len(cmd)}\r\n".encode() + b"".join(f"${len(c)}\r\n{c}\r\n".encode() for c in cmd))
        f = s.makefile("rb")
        line = f.readline()
        if line[:1] == b"$":
            return f.read(int(line[1:])).decode()
        if line[:1] == b"-":
            raise RuntimeError(line.decode().strip())
        return line[1:].decode().strip()


def redis_info(section):
    return dict(l.split(":", 1) for l in redis("INFO", section).splitlines() if ":" in l)


def redis_rss_mb():
    try:
        return round(int(redis_info("memory")["used_memory_rss"]) / 1048576, 1)
    except Exception:
        return None


# --- processes -------------------------------------------------------------------------------

def session_pids(sid):
    """Every live process in the session `sid` (the app's launcher is a session leader)."""
    pids = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            stat = open(f"/proc/{d}/stat").read()
        except OSError:
            continue
        fields = stat[stat.rindex(")") + 2:].split()   # after "pid (comm) "
        if int(fields[3]) == sid and fields[0] != "Z":  # fields: state ppid pgrp session ...
            pids.append(int(d))
    return pids


def role(cmd):
    for needle, r in (("thrust", "thrust"), ("puma", "puma"), ("resque", "jobs"), ("beam.smp", "beam"),
                      ("campfire-vips", "helpers"), ("campfire-html", "helpers"), ("ffmpeg", "helpers")):
        if needle in cmd:
            return r
    return "other"


def snapshot(sid):
    """{role: {pss_mb, rss_mb, procs}} plus totals, from smaps_rollup."""
    roles, total = {}, {"pss_mb": 0.0, "rss_mb": 0.0, "procs": 0}
    for pid in session_pids(sid):
        try:
            cmd = open(f"/proc/{pid}/cmdline").read().replace("\0", " ")
            m = {}
            for line in open(f"/proc/{pid}/smaps_rollup"):
                k, _, v = line.partition(":")
                if k in ("Rss", "Pss"):
                    m[k] = int(v.split()[0]) / 1024
        except OSError:
            continue
        r = roles.setdefault(role(cmd), {"pss_mb": 0.0, "rss_mb": 0.0, "procs": 0})
        for d in (r, total):
            d["pss_mb"] += m.get("Pss", 0); d["rss_mb"] += m.get("Rss", 0); d["procs"] += 1
    return total, roles


def process_model(sid):
    """What actually runs: role, threads, cmdline (and BEAM scheduler threads), for the results JSON."""
    procs = []
    for pid in sorted(session_pids(sid)):
        try:
            cmd = open(f"/proc/{pid}/cmdline").read().replace("\0", " ").strip()
            comms = [open(t + "/comm").read().strip() for t in glob.glob(f"/proc/{pid}/task/*")]
        except OSError:
            continue
        p = {"role": role(cmd), "threads": len(comms), "cmd": cmd[:160]}
        if "beam.smp" in cmd:  # thread names: erts_sched_N, erts_dcpus_N, erts_dios_N (ERTS 16+)
            p["schedulers"] = sum(c.startswith("erts_sched_") for c in comms)
            p["dirty_cpu_schedulers"] = sum(c.startswith("erts_dcpus_") for c in comms)
            p["dirty_io_schedulers"] = sum(c.startswith("erts_dios_") for c in comms)
        if "puma" in cmd:
            p["puma"] = "worker" if "cluster worker" in cmd else "master"
        if "resque" in cmd:
            p["resque"] = "pool" if "pool" in cmd else "worker"
        procs.append(p)
    return procs


def observed_model(model):
    """One line: what the process tree really is (Puma workers, resque workers, BEAM schedulers by thread count)."""
    parts = []
    workers = [p for p in model if p.get("puma") == "worker"]
    if any("puma" in p for p in model):
        max_threads = dict(kv.split("=", 1) for kv in app_env(NCPU))["RAILS_MAX_THREADS"]
        parts.append(f"puma workers {len(workers)} (OS threads per worker {[p['threads'] for p in workers]}, "
                     f"RAILS_MAX_THREADS {max_threads})")
    if any("resque" in p for p in model):
        parts.append(f"resque workers {sum(p.get('resque') == 'worker' for p in model)}")
    for p in model:
        if "schedulers" in p:
            parts.append(f"beam threads: {p['schedulers']} schedulers, {p['dirty_cpu_schedulers']} dirty cpu, "
                         f"{p['dirty_io_schedulers']} dirty io")
    parts.append(f"{len(model)} processes: " + ", ".join(sorted({p['role'] for p in model})))
    return "; ".join(parts)


def beam_check(rel):
    """Scheduler counts as the app's VM sees them: a one-off `bin/campfire eval` under the same taskset and
    ELIXIR_ERL_OPTIONS (distribution is off, so the running node can't be asked over rpc)."""
    run = os.path.join(BENCH, ".work", "beam-check")
    shutil.rmtree(run, ignore_errors=True)
    for d in ("tmp", "home"):
        os.makedirs(os.path.join(run, d))
    env = {**base_env(run), "RELEASE_DISTRIBUTION": "none", "RELEASE_TMP": os.path.join(run, "tmp"),
           "ELIXIR_ERL_OPTIONS": ERL_OPTIONS}
    si = lambda k: f"#{{:erlang.system_info(:{k})}}"
    expr = (f'IO.puts("schedulers_online={si("schedulers_online")}/{si("schedulers")} '
            f'dirty_cpu_schedulers_online={si("dirty_cpu_schedulers_online")} dirty_io_schedulers={si("dirty_io_schedulers")} '
            f'otp={si("otp_release")} elixir=#{{System.version()}}")')
    r = subprocess.run(["taskset", "-c", SERVER_CPUS, os.path.join(rel, "bin", "campfire"), "eval", expr],
                       env=env, capture_output=True, text=True, timeout=60)
    shutil.rmtree(run, ignore_errors=True)
    last = (r.stdout.strip().splitlines() or ["?"])[-1]
    return last + (f" (exit {r.returncode}: {r.stderr.strip()[-300:]})" if r.returncode else "")


class Sampler(threading.Thread):
    def __init__(self, sid):
        super().__init__(daemon=True)
        self.sid, self.stop, self.peak, self.roles = sid, threading.Event(), {"pss_mb": 0.0, "rss_mb": 0.0}, {}

    def run(self):
        while not self.stop.is_set():
            total, roles = snapshot(self.sid)
            for k in ("pss_mb", "rss_mb"):
                self.peak[k] = max(self.peak[k], total[k])
            for r, v in roles.items():
                cur = self.roles.setdefault(r, {"peak_pss_mb": 0.0, "procs": 0})
                cur["peak_pss_mb"] = round(max(cur["peak_pss_mb"], v["pss_mb"]), 1)
                cur["procs"] = max(cur["procs"], v["procs"])
            self.stop.wait(0.25)


def kill_session(sid, grace=10):
    pids = session_pids(sid)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        deadline = time.time() + grace
        while time.time() < deadline:
            pids = session_pids(sid)
            if not pids:
                return
            time.sleep(0.1)
        log(f"session {sid}: {len(pids)} process(es) survived {sig.name}")
    if session_pids(sid):
        raise SystemExit(f"could not kill session {sid}")


def port_free(port):
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", port)) != 0


def up():
    try:
        return urllib.request.urlopen(BASE + "/up", timeout=2).status == 200
    except Exception:
        return False


# --- the apps --------------------------------------------------------------------------------

def base_env(run):
    env = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": os.path.join(run, "home"), "LANG": "C.UTF-8",
           "USER": os.environ.get("USER", ""), "TMPDIR": os.path.join(run, "tmp")}
    env.update(dict(kv.split("=", 1) for kv in app_env(NCPU)))
    return env


def launch(app, run):
    """(argv, env, cwd) for the app's production process model, with its state in `run`."""
    env = base_env(run)
    db, files = os.path.join(run, "db", "production.sqlite3"), os.path.join(run, "files")
    timeouts = {"HTTP_IDLE_TIMEOUT": "60", "HTTP_READ_TIMEOUT": "300", "HTTP_WRITE_TIMEOUT": "300"}  # both images' ENV
    if app == "reference":
        # Rails.root/storage/{db,files} (config/database.yml, config/storage.yml) -> the run dir.
        link = os.path.join(REFERENCE_DIR, "storage")
        if os.path.islink(link) or os.path.exists(link):
            os.remove(link) if os.path.islink(link) else shutil.rmtree(link)
        os.symlink(run, link)
        env.update(timeouts)
        env.update({"PATH": ruby_bin() + ":" + env["PATH"], "BUNDLE_DEPLOYMENT": "1", "BUNDLE_WITHOUT": "development",
                    "LD_PRELOAD": JEMALLOC, "REDIS_URL": REDIS_URL,
                    "HTTP_PORT": str(PORT), "TARGET_PORT": str(PORT + 1)})
        # Procfile minus its redis line (Redis is external), supervised by bash instead of bin/boot.
        cmd = ("bundle exec thrust bin/start-app & "
               "FORK_PER_JOB=false INTERVAL=0.1 bundle exec resque-pool & wait")
        return ["bash", "-c", cmd], env, REFERENCE_DIR
    if app == "elixir-official":
        # bin/container-start, minus starting its own redis-server (REDIS_URL is set).
        env.update(timeouts)
        env.update({"PATH": OFFICIAL_BIN + ":" + env["PATH"], "REDIS_URL": REDIS_URL, "CAMPFIRE_WORKER": "1",
                    "HTTP_PORT": str(PORT), "TARGET_PORT": str(PORT + 1), "CAMPFIRE_BIND": "loopback",
                    "THRUSTER_STORAGE_PATH": os.path.join(run, "thruster"),
                    "DATABASE_PATH": db, "STORAGE_PATH": files, "RAILS_ENV": "production",
                    "RELEASE_DISTRIBUTION": "none", "RELEASE_TMP": os.path.join(run, "tmp"),
                    "ELIXIR_ERL_OPTIONS": ERL_OPTIONS})
        return [thrust(), os.path.join(OFFICIAL_REL, "bin", "campfire"), "start"], env, run
    # ours: the release serves HTTP_PORT itself (as the image's CMD; env as its Dockerfile).
    env.update({"HTTP_PORT": str(PORT), "DATABASE_PATH": db, "STORAGE_PATH": files,
                "RELEASE_DISTRIBUTION": "none", "RELEASE_TMP": os.path.join(run, "tmp"),
                "ELIXIR_ERL_OPTIONS": ERL_OPTIONS})
    return [os.path.join(OURS_REL, "bin", "campfire"), "start"], env, run


def copy_seed(run):
    shutil.rmtree(run, ignore_errors=True)
    for d in ("db", "tmp", "home", "thruster"):
        os.makedirs(os.path.join(run, d))
    shutil.copy2(os.path.join(SEED, "db", "production.sqlite3"), os.path.join(run, "db"))
    subprocess.run(["cp", "-a", "--reflink=auto", os.path.join(SEED, "storage"), os.path.join(run, "files")], check=True)
    neuter_deliveries(os.path.join(run, "db", "production.sqlite3"))


def start_app(app, run, logf):
    for p in (PORT, PORT + 1):
        if not port_free(p):
            raise SystemExit(f"port {p} is in use")
    copy_seed(run)
    if app != "ours":
        redis("FLUSHALL")
    argv, env, cwd = launch(app, run)
    os.sync()
    t0 = time.time()
    proc = subprocess.Popen(["taskset", "-c", SERVER_CPUS, *argv], env=env, cwd=cwd, stdin=subprocess.DEVNULL,
                            stdout=logf, stderr=subprocess.STDOUT, start_new_session=True)
    while time.time() - t0 < 120:
        if up():
            return proc, round((time.time() - t0) * 1000)
        if proc.poll() is not None:
            break
        time.sleep(0.02)
    kill_session(proc.pid)
    logf.flush()
    print(open(logf.name).read()[-4000:], file=sys.stderr)
    raise SystemExit(f"{app}: /up never answered 200")


def wait_for_quiet():
    waited = 0
    while os.getloadavg()[0] >= LOAD_MAX and waited < LOAD_WAIT_SECS:
        time.sleep(10); waited += 10
    log(f"load before run: {open('/proc/loadavg').read().strip()} (waited {waited}s)")


def run_rep(app, rep, out, labels):
    wait_for_quiet()
    load0 = open("/proc/loadavg").read().strip()
    run = os.path.join(BENCH, ".work", app)
    with open(os.path.join(out, f".{app}-{rep}.log"), "w") as logf:
        proc, cold = start_app(app, run, logf)
        sampler = None
        try:
            time.sleep(SETTLE_SECS)
            idle, idle_roles = snapshot(proc.pid)
            model = process_model(proc.pid)
            redis_idle = redis_rss_mb()
            sampler = Sampler(proc.pid); sampler.start()
            observed = observed_model(model)
            with open(os.path.join(out, "env.txt"), "a") as e:
                print(f"observed {app} rep {rep}: {observed}", file=e)
            log(f"{app} rep {rep}: {observed}")
            log(f"{app} rep {rep}: cold start {cold}ms, idle PSS {idle['pss_mb']:.0f}MB RSS {idle['rss_mb']:.0f}MB "
                f"in {idle['procs']} processes" + "".join(f"; {p['role']}: {p['schedulers']} schedulers" for p in model if "schedulers" in p))

            http, cable, upload = run_suites(app, rep, out, labels, lg)

            sampler.stop.set(); sampler.join()
            peak = sampler.peak
            memory = {"idle_pss_mb": round(idle["pss_mb"], 1), "idle_rss_mb": round(idle["rss_mb"], 1),
                      "peak_pss_mb": round(peak["pss_mb"], 1), "peak_rss_mb": round(peak["rss_mb"], 1),
                      "idle_roles_pss_mb": {r: round(v["pss_mb"], 1) for r, v in idle_roles.items()},
                      "peak_roles": sampler.roles,
                      "redis_rss_mb_idle": redis_idle if app != "ours" else None,
                      "redis_rss_mb_end": redis_rss_mb() if app != "ours" else None}
        finally:
            if sampler:
                sampler.stop.set()
            kill_session(proc.pid)
            proc.wait()
    f = os.path.join(out, f"{app}-{rep}.json")
    json.dump({"app": app, "rep": rep, "mode": "native", "cold_start_ms": cold, "memory": memory,
               "process_model": model, "http": http, "cable": cable, "upload": upload,
               "loadavg_start": load0, "loadavg_end": open("/proc/loadavg").read().strip()}, open(f, "w"), indent=1)
    shutil.rmtree(run, ignore_errors=True)
    log(f"{app} rep {rep}: done -> {f}")


# --- environment record ----------------------------------------------------------------------

def git_rev(d):
    rev = sh("git", "-C", d, "rev-parse", "HEAD", check=False)
    dirty = sh("git", "-C", d, "status", "--porcelain", "--untracked-files=no", check=False)
    return f"{rev}{' (dirty: ' + str(len(dirty.splitlines())) + ' files)' if dirty else ''}"


def siblings(cpus):
    out = set()
    for part in cpus.split(","):
        a, _, b = part.partition("-")
        for c in range(int(a), int(b or a) + 1):
            out.add(open(f"/sys/devices/system/cpu/cpu{c}/topology/thread_siblings_list").read().strip())
    return " ".join(sorted(out))


def check_prereqs(apps):
    need = {"reference": [os.path.join(REFERENCE_DIR, "public", "assets")],
            "elixir-official": [os.path.join(OFFICIAL_REL, "bin", "campfire"), os.path.join(OFFICIAL_BIN, "campfire-vips")],
            "ours": [os.path.join(OURS_REL, "bin", "campfire")]}
    for app in apps:
        if app not in APPS:
            raise SystemExit(f"unknown app {app} (one of {', '.join(APPS)})")
        for p in need[app]:
            if not os.path.exists(p):
                raise SystemExit(f"{app}: {p} missing: run bench/setup-native")
        if app != "ours":
            thrust()
            try:
                redis("PING")
            except OSError as e:
                raise SystemExit(f"{app} needs Redis at {REDIS_URL}: {e}")


