    lines = [f"date: {datetime.now().isoformat()}",
             "mode: native (bench/run-native), bare processes, loopback",
             f"host: {os.uname().nodename}, {sh('uname', '-r')}, "
             f"{sh('sh', '-c', 'grep -m1 \"model name\" /proc/cpuinfo | cut -d: -f2').strip()}, {os.cpu_count()} threads, "
             f"{os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES') // 2**30}GB, "
             f"{sh('sh', '-c', '. /etc/os-release; echo $PRETTY_NAME')}",
             f"governor: {sh('sh', '-c', 'cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null; cat /sys/devices/system/cpu/cpufreq/boost /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null', check=False).replace(chr(10), ' ')}",
             f"server cpus: {SERVER_CPUS} (siblings {siblings(SERVER_CPUS)}; process model for {NCPU} cpus); "
             f"loadgen cpus: {LOADGEN_CPUS} (siblings {siblings(LOADGEN_CPUS)}); harness: {HARNESS_CPUS}",
             f"suites: {SUITES} http secs {HTTP_SECS} concs {HTTP_CONCS} cable {CABLE_CLIENTS}",
             f"env: {' '.join(x for x in app_env(NCPU) if 'CONCURRENCY' in x or 'THREADS' in x)} {' '.join(EXTRA_ENV)}",
             f"loadgen: {git_rev(ROOT)} (bench/loadgen)"]
    if any(a != "ours" for a in apps):
        info = redis_info("server")
        lines.append(f"redis (external, shared, FLUSHALL per run): {REDIS_URL} redis {info.get('redis_version')}")
        lines.append(f"thruster: {thrust()}")
    if "reference" in apps:
        env = {**os.environ, "PATH": ruby_bin() + ":" + os.environ["PATH"]}
        lines.append(f"reference: {REFERENCE_DIR} @ {git_rev(REFERENCE_DIR)}; {sh('ruby', '-v', env=env)}; "
                     f"jemalloc {JEMALLOC}; libvips {sh('pkg-config', '--modversion', 'vips', check=False)}")
    for app, rel, d in (("elixir-official", OFFICIAL_REL, OFFICIAL_DIR), ("ours", OURS_REL, ROOT)):
        if app in apps:
            erts = sorted(glob.glob(os.path.join(rel, "erts-*")))
            elixir = sorted(glob.glob(os.path.join(rel, "lib", "elixir-*")))
            lines.append(f"{app}: {d} @ {git_rev(d)}; release {os.path.basename(erts[-1]) if erts else '?'} "
                         f"{os.path.basename(elixir[-1]) if elixir else '?'}; ELIXIR_ERL_OPTIONS=\"{ERL_OPTIONS}\"; "
                         f"VM under taskset {SERVER_CPUS}: {beam_check(rel)}")
    open(os.path.join(out, "env.txt"), "w").write("\n".join(lines) + "\n")
    sys.stderr.write("\n".join(lines) + "\n")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--apps", default="reference,ours")
    p.add_argument("--reps", type=int, default=3)
    p.add_argument("--out")
    p.add_argument("--user-agent")
    a = p.parse_args()
    if a.user_agent:
        UA.extend(["--user-agent", a.user_agent])
    apps = a.apps.split(",")
    check_prereqs(apps)
    labels = load_labels()
    os.sched_setaffinity(0, {c for part in HARNESS_CPUS.split(",") for c in
                             range(int(part.partition("-")[0]), int(part.partition("-")[2] or part.partition("-")[0]) + 1)})
    out = a.out or os.path.join(BENCH, "results", "linux-" + datetime.now().strftime("%Y%m%d-%H%M%S"))
    os.makedirs(out, exist_ok=True)

    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    resource.setrlimit(resource.RLIMIT_NOFILE, (min(65536, hard), hard))
    # A mise shim for cargo can exist without a version set: use cargo only if it actually runs.
    cargo = ["cargo"] if subprocess.run(["cargo", "--version"], capture_output=True, check=False).returncode == 0 \
        else ["mise", "exec", "rust@stable", "--", "cargo"]
    subprocess.run([*cargo, "build", "--release", "-q"], cwd=os.path.join(BENCH, "loadgen"), check=True)
    write_env(out, apps)

    for rep in range(1, a.reps + 1):
        for app in (apps if rep % 2 else apps[::-1]):
            run_rep(app, rep, out, labels)
    write_report(out)


if __name__ == "__main__":
    main()
